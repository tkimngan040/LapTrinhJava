        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;erDiagram\n    BRANDS {\n        bigint brand_id PK\n        varchar name UK\n        varchar logo_url\n        text description\n        varchar status\n        timestamptz created_at\n    }\n    ROLES {\n        bigint role_id PK\n        varchar role_name UK\n        varchar description\n    }\n    USERS {\n        bigint user_id PK\n        bigint brand_id FK \&quot;NULL = super admin\&quot;\n        varchar email UK\n        varchar password_hash\n        varchar full_name\n        varchar status\n        integer token_version \&quot;increment = revoke JWT\&quot;\n        timestamptz created_at\n    }\n    USER_ROLES {\n        bigint user_id PK, FK\n        bigint role_id PK, FK\n        timestamptz assigned_at\n    }\n    LOCATIONS {\n        bigint location_id PK\n        bigint brand_id FK\n        varchar name\n        text address\n        varchar status\n    }\n    PRODUCTS {\n        bigint product_id PK\n        bigint brand_id FK\n        varchar name\n        text description\n        varchar image_url\n        varchar fragrance_notes\n        numeric price_per_spray \&quot;default price\&quot;\n        varchar status\n    }\n    MACHINES {\n        bigint machine_id PK\n        bigint brand_id FK\n        bigint location_id FK\n        varchar serial_number UK\n        varchar device_identity UK\n        varchar firmware_version\n        varchar connection_status\n        varchar operating_status\n        timestamptz last_seen_at\n        timestamptz created_at\n    }\n    MACHINE_SLOTS {\n        bigint slot_id PK\n        bigint brand_id FK\n        bigint machine_id FK\n        bigint product_id FK\n        integer slot_number \&quot;UK with machine_id\&quot;\n        numeric price \&quot;NULL = use product price\&quot;\n        numeric low_stock_threshold\n        integer spray_duration_ms\n        varchar status\n    }\n    INVENTORY_BATCHES {\n        bigint batch_id PK\n        bigint brand_id FK\n        bigint product_id FK\n        varchar batch_number\n        numeric quantity_received\n        timestamptz received_at\n        date expiration_date\n        varchar status\n    }\n    INVENTORY_BOTTLES {\n        bigint bottle_id PK\n        bigint brand_id FK\n        bigint batch_id FK\n        bigint slot_id FK \&quot;partial UK: 1 installed bottle / slot\&quot;\n        varchar bottle_code UK\n        numeric initial_quantity\n        numeric remaining_quantity\n        varchar status\n        timestamptz installed_at\n        timestamptz removed_at\n    }\n    INVENTORY_MOVEMENTS {\n        bigint movement_id PK\n        bigint brand_id FK\n        bigint bottle_id FK\n        bigint user_id FK\n        varchar movement_type\n        numeric quantity\n        numeric quantity_before\n        numeric quantity_after\n        varchar reason \&quot;required for ADJUSTMENT\&quot;\n        timestamptz created_at\n    }\n    ORDERS {\n        bigint order_id PK\n        bigint brand_id FK\n        bigint machine_id FK\n        bigint slot_id FK\n        bigint product_id FK\n        numeric price_snapshot\n        char currency\n        varchar status\n        timestamptz expires_at\n        timestamptz created_at\n    }\n    PAYMENTS {\n        bigint payment_id PK\n        bigint brand_id FK\n        bigint order_id FK\n        varchar provider_reference UK\n        varchar payment_method\n        numeric amount\n        char currency\n        varchar status\n        timestamptz paid_at\n        timestamptz created_at\n    }\n    PAYMENT_REFUNDS {\n        bigint refund_id PK\n        bigint brand_id FK\n        bigint payment_id FK\n        varchar refund_reference UK\n        numeric amount\n        varchar reason\n        varchar status\n        timestamptz created_at\n        timestamptz completed_at\n    }\n    DISPENSE_COMMANDS {\n        bigint command_id PK\n        bigint brand_id FK\n        bigint order_id FK \&quot;partial UK: 1 active command / order\&quot;\n        bigint slot_id FK\n        varchar command_reference UK\n        varchar idempotency_key UK\n        varchar signature\n        varchar status\n        timestamptz created_at\n        timestamptz expires_at \&quot;TTL 30s\&quot;\n        timestamptz acked_at\n        timestamptz executed_at\n        text failure_reason\n    }\n    DEVICE_EVENTS {\n        bigint event_id PK\n        bigint brand_id FK\n        bigint machine_id FK\n        varchar event_type\n        varchar event_reference UK\n        jsonb event_data\n        timestamptz occurred_at\n        timestamptz received_at\n    }\n    TELEMETRY_READINGS {\n        bigint reading_id PK\n        bigint brand_id FK\n        bigint machine_id FK\n        bigint slot_id FK\n        varchar reading_reference \&quot;UK with machine_id\&quot;\n        numeric weight_g\n        numeric estimated_remaining\n        boolean door_open\n        boolean leak_detected\n        varchar actuator_state\n        varchar power_status\n        timestamptz occurred_at\n        timestamptz received_at\n    }\n    INCIDENTS {\n        bigint incident_id PK\n        bigint brand_id FK\n        bigint order_id FK\n        bigint machine_id FK\n        bigint assigned_user_id FK\n        varchar incident_type\n        varchar severity\n        varchar status\n        text description\n        timestamptz created_at\n        timestamptz resolved_at\n    }\n    ALERTS {\n        bigint alert_id PK\n        bigint brand_id FK\n        bigint machine_id FK\n        bigint incident_id FK\n        bigint assigned_user_id FK\n        varchar alert_type\n        varchar severity\n        varchar status\n        text message\n        timestamptz created_at\n        timestamptz acknowledged_at\n        timestamptz resolved_at\n    }\n    NOTIFICATIONS {\n        bigint notification_id PK\n        bigint brand_id FK\n        bigint user_id FK\n        bigint alert_id FK\n        varchar notification_type\n        text message\n        varchar status\n        timestamptz created_at\n        timestamptz read_at\n    }\n    MAINTENANCE_TICKETS {\n        bigint ticket_id PK\n        bigint brand_id FK\n        bigint machine_id FK\n        bigint alert_id FK\n        bigint assigned_user_id FK\n        varchar category\n        varchar priority\n        varchar status\n        text description\n        text corrective_action\n        timestamptz created_at\n        timestamptz due_at\n        timestamptz completed_at\n    }\n    MAINTENANCE_TASKS {\n        bigint task_id PK\n        bigint brand_id FK\n        bigint ticket_id FK\n        bigint assigned_user_id FK\n        integer sort_order \&quot;UK with ticket_id\&quot;\n        varchar task_name\n        text task_result\n        varchar status\n        timestamptz completed_at\n    }\n    AUDIT_LOGS {\n        bigint audit_id PK\n        bigint brand_id FK\n        bigint user_id FK\n        varchar action\n        varchar entity_type\n        bigint entity_id\n        jsonb old_values\n        jsonb new_values\n        varchar source_ip\n        timestamptz created_at\n    }\n\n    BRANDS |o--o{ USERS : has\n    BRANDS ||--o{ LOCATIONS : operates\n    BRANDS ||--o{ PRODUCTS : owns\n    BRANDS ||--o{ MACHINES : owns\n    BRANDS |o--o{ AUDIT_LOGS : records\n    USERS ||--o{ USER_ROLES : has\n    ROLES ||--o{ USER_ROLES : defines\n    USERS |o--o{ AUDIT_LOGS : performs\n\n    LOCATIONS |o--o{ MACHINES : contains\n    MACHINES ||--o{ MACHINE_SLOTS : contains\n    PRODUCTS |o--o{ MACHINE_SLOTS : configured_for\n\n    PRODUCTS ||--o{ INVENTORY_BATCHES : stocked_as\n    INVENTORY_BATCHES ||--o{ INVENTORY_BOTTLES : contains\n    MACHINE_SLOTS |o--o{ INVENTORY_BOTTLES : installed_in\n    INVENTORY_BOTTLES ||--o{ INVENTORY_MOVEMENTS : records\n    USERS |o--o{ INVENTORY_MOVEMENTS : performs\n\n    MACHINES ||--o{ ORDERS : serves\n    MACHINE_SLOTS ||--o{ ORDERS : selected_for\n    PRODUCTS ||--o{ ORDERS : ordered_as\n    ORDERS ||--o{ PAYMENTS : has\n    PAYMENTS ||--o{ PAYMENT_REFUNDS : may_have\n    ORDERS ||--o{ DISPENSE_COMMANDS : triggers\n    MACHINE_SLOTS ||--o{ DISPENSE_COMMANDS : targets\n\n    MACHINES ||--o{ DEVICE_EVENTS : emits\n    MACHINES ||--o{ TELEMETRY_READINGS : reports\n    MACHINE_SLOTS |o--o{ TELEMETRY_READINGS : measures\n\n    ORDERS |o--o{ INCIDENTS : may_cause\n    MACHINES ||--o{ INCIDENTS : experiences\n    USERS |o--o{ INCIDENTS : handles\n    INCIDENTS |o--o{ ALERTS : groups\n    MACHINES ||--o{ ALERTS : generates\n    USERS |o--o{ ALERTS : assigned_to\n    ALERTS |o--o{ NOTIFICATIONS : creates\n    USERS ||--o{ NOTIFICATIONS : receives\n    MACHINES ||--o{ MAINTENANCE_TICKETS : requires\n    ALERTS |o--o{ MAINTENANCE_TICKETS : generates\n    USERS |o--o{ MAINTENANCE_TICKETS : assigned_to\n    MAINTENANCE_TICKETS ||--o{ MAINTENANCE_TASKS : contains\n    USERS |o--o{ MAINTENANCE_TASKS : performs\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="972">
