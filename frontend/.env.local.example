# Copy to .env.local. Neither file is committed with real values in it.

# Where the Spring Boot API answers. The default is the same, so this only
# needs setting when the backend runs somewhere else.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Set to true to sign in against the fixtures in src/mocks instead of the API,
# for working on the screens with no backend running. Leave it out or set it
# to false for anything that is being demonstrated or tested.
NEXT_PUBLIC_USE_MOCKS=false
