{
  "info": {
    "name": "ScentStation A2 - Brands and Users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all requests in order against a development database. Set baseUrl, psaEmail and psaPassword. Creates uniquely named A/B brands and test accounts; retains them for inspection."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "psaEmail",
      "value": "psa@scentstation.local"
    },
    {
      "key": "psaPassword",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "A2-test-password"
    },
    {
      "key": "resetPassword",
      "value": "A2-reset-password"
    }
  ],
  "item": [
    {
      "name": "01 PSA login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{psaEmail}}\",\n  \"password\": \"{{psaPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"psaToken\", pm.response.json().token);",
              "pm.collectionVariables.set(\"runId\", Date.now().toString() + Math.floor(Math.random() * 100000));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create brand A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{psaToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/brands",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A2 Brand A {{runId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"brandA\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create brand B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
