              "pm.test(\"Every user belongs to A\", () => { const users = pm.response.json(); pm.expect(users.length).to.be.above(0); users.forEach(u => { pm.expect(u.brandId).to.eql(Number(pm.collectionVariables.get(\"brandA\"))); pm.expect(u).not.to.have.property(\"passwordHash\"); }); });"
            ]
          }
        }
      ]
