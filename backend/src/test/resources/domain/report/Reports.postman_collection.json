    {
      "name": "14 Viewer cannot export",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/reports/orders?format=csv"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Supervisor CSV uses full scope and approved headers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{psaToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/reports/orders?brandId={{brandA}}&format=csv&size=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"CSV includes all 120 orders\", () => { const text = pm.response.text(); pm.expect(text).to.include('\"orderId\",\"createdAt\",\"kioskCode\",\"brandName\",\"productName\",\"volumeMl\",\"amount\",\"currency\",\"status\"'); pm.expect(text.trim().split(/\\r?\\n/).length).to.eql(121); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Invalid dates rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{viewerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/reports/orders?from=2024-07-02&to=2024-07-01"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
